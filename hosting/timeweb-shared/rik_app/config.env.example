# Copy this file to config.env outside public_html and fill values there.
# Never commit config.env or put it inside public_html.

# Real local model transport. The worker on the office machine polls these
# private endpoints over HTTPS, so no inbound port to the office is required.
LOCAL_RELAY_ENABLED=true
LOCAL_RELAY_TOKEN=
LOCAL_RELAY_WAIT_SECONDS=45
LOCAL_RELAY_POLL_MILLISECONDS=200
LOCAL_RELAY_MAX_QUEUED_JOBS=50
LOCAL_RELAY_CLAIM_TIMEOUT_SECONDS=180
LOCAL_RELAY_RESULT_RETENTION_SECONDS=900

OPENROUTER_API_KEY=
OPENROUTER_MODELS=
OPENROUTER_SITE_URL=https://rik-vent.ru
OPENROUTER_APP_NAME=RIK website
OPENROUTER_TIMEOUT_SECONDS=45
OPENROUTER_TEMPERATURE=0.6

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RAG_TOP_K=8
RAG_SIMILARITY_THRESHOLD=0.25
RAG_MAX_CONTEXT_CHARS=12000
RAG_NAMESPACE=site
RAG_EMBEDDING_MODEL=openai/text-embedding-3-small

MAX_HISTORY_MESSAGES=20
MAX_MESSAGE_CHARS=3000
KNOWLEDGE_MAX_CHARS=12000
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_MAX_BUCKETS=10000
CHAT_SESSION_RETENTION_SECONDS=604800
CHAT_MAX_SESSIONS=5000
CHAT_FORCE_LOCAL=false
CHAT_FALLBACK_MESSAGE=Чат-ассистент временно недоступен: модель не ответила вовремя. Попробуйте позже или отправьте заявку через «Запросить расчёт».
CHAT_RATE_LIMIT_MESSAGE=Слишком много сообщений за короткое время. Подождите минуту и попробуйте снова.

REQUEST_RECIPIENT=zakaz@rik-vent.ru
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# Optional custom CA bundle path. Leave empty in production to use the system trust store.
SMTP_CA_FILE=
SMTP_TIMEOUT_SECONDS=30
REQUEST_MAIL_MODE=smtp
REQUEST_MAX_FILES=10
REQUEST_MAX_TOTAL_BYTES=26214400
REQUEST_MAX_FILE_BYTES=15728640
REQUEST_MAX_BODY_BYTES=31457280
REQUEST_MAX_FIELD_CHARS=5000
REQUEST_RATE_LIMIT_WINDOW_SECONDS=600
REQUEST_RATE_LIMIT_MAX_REQUESTS=5

# Tests may explicitly set REQUEST_MAIL_MODE=log and use this file.
REQUEST_MAIL_LOG=
