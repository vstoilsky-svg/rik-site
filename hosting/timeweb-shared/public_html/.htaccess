DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On

# Preserve search equity from the pre-2026 Bitrix URL structure.
# Directory rules accept both the historical trailing-slash URL and its
# no-slash variant, but always land on the current canonical URL.
RewriteRule ^catalog/tsentralnye_karkasnye_konditsionery_rik_m_i_rik_s/?$ /product/centralnye-ustanovki/ [R=301,L,NE]
RewriteRule ^catalog/klapana_protivopozharnye_kanalnye_/?$ /product/protivopozharnye-klapany/ [R=301,L,NE]
RewriteRule ^catalog/sektsii_plastinchatykh_rekuperatorov_rp/?$ /product/centralnye-ustanovki/plastinchatye-rekuperatory/ [R=301,L,NE]
RewriteRule ^catalog/kanalnoe_oborudovanie/?$ /product/kanalnoe-oborudovanie/ [R=301,L,NE]
RewriteRule ^company/blog/printsip_raboty_tsentralnykh_karkasno_panelnykh_konditsionerov/?$ /product/centralnye-ustanovki/ [R=301,L,NE]
RewriteRule ^catalog/klapana/?$ /product/specialnye-klapany/ [R=301,L,NE]
RewriteRule ^upload/medialibrary/0bd/ayn0ko0zc8e8gc38960kbcyhwb816coe\.pdf$ /product/centralnye-ustanovki/ [R=301,L,NE]
RewriteRule ^catalog/ventilyatory_kanalnye_wr_i_wrn/?$ /product/ventilyator-wr/ [R=301,L,NE]
RewriteRule ^catalog/zatvory/?$ /product/ventilyatsionnye-zatvory/ [R=301,L,NE]
RewriteRule ^catalog/kanalnoe_krugloe_oborudovanie/?$ /product/kanalnoe-krugloe/ [R=301,L,NE]
RewriteRule ^catalog/plastinchatye_rekuperatory_rec/?$ /product/plastinchatyj-rekuperator-rec/ [R=301,L,NE]
RewriteRule ^catalog/reguliruyushchie_zaslonki_s/?$ /product/zaslonka-reguliruyushchaya-rkz/ [R=301,L,NE]
RewriteRule ^catalog/elektricheskie_vozdukhonagrevateli_euuu/?$ /product/elektricheskie-vozduhonagrevateli-re/ [R=301,L,NE]
RewriteRule ^catalog/nerzhaveyushchaya_stal_ot_0_5_do_1_0/?$ /product/vozduhovody-i-fasonnye-izdeliya/ [R=301,L,NE]
RewriteRule ^catalog/ventilyatory_kanalnye_/?$ /product/kanalnoe-oborudovanie/ [R=301,L,NE]
RewriteRule ^catalog/zonty_kryshnyy/?$ /product/vozduhovody-i-fasonnye-izdeliya/ [R=301,L,NE]
RewriteRule ^company/blog/printsip_raboty_vozdushnykh_zaslonok_ruchnye_mekhanicheskie_i_avtomaticheskie/?$ /product/specialnye-klapany/ [R=301,L,NE]
RewriteRule ^upload/medialibrary/3eb/5tftc56ji3vyx6gj8q51x7ckr0lv6224\.pdf$ /product/protivopozharnye-klapany/ [R=301,L,NE]
RewriteRule ^catalog/?$ /products/ [R=301,L,NE]
RewriteRule ^catalog/kanalnoe_pryamougolnoe_oborudovanie/?$ /product/kanalnoe-pryamougolnoe/ [R=301,L,NE]
RewriteRule ^company/?$ /about/ [R=301,L,NE]
RewriteRule ^company/articles/?$ /projects/ [R=301,L,NE]
RewriteRule ^company/rekvizity/?$ /requisites/ [R=301,L,NE]
RewriteRule ^company/jobs/?$ /careers/ [R=301,L,NE]
RewriteRule ^dostavka-oplata-garantii/?$ /about/ [R=301,L,NE]
RewriteRule ^dostavka-oplata-garantii/dostavka/?$ /contacts/ [R=301,L,NE]
RewriteRule ^dostavka-oplata-garantii/garantii/?$ /about/ [R=301,L,NE]
RewriteRule ^dostavka-oplata-garantii/oplata/?$ /contacts/ [R=301,L,NE]
RewriteRule ^izgotovlenie-na-zakaz/?$ /production/ [R=301,L,NE]
RewriteRule ^sale/sad/?$ /news/ [R=301,L,NE]
RewriteRule ^help/delivery/?$ /contacts/ [R=301,L,NE]
RewriteRule ^kak-oformit-zakaz/?$ /request/ [R=301,L,NE]
RewriteRule ^legacy-cookies-agreement\.php$ /privacy/ [R=301,L,NE]

# Indexed legacy model cards keep the closest current product/category intent.
# Final namespace fallbacks prevent any remaining Bitrix result from landing on 404.
RewriteRule ^catalog/sektsii_plastinchatykh_rekuperatorov_rp/[0-9]+/?$ /product/centralnye-ustanovki/plastinchatye-rekuperatory/ [R=301,L,NE]
RewriteRule ^catalog/elektricheskie_vozdukhonagrevateli_euuu/[0-9]+/?$ /product/centralnye-ustanovki/elektricheskie-nagrevateli/ [R=301,L,NE]
RewriteRule ^catalog/sektsiya_isparitelya_freonovogo_cxy/[0-9]+/?$ /product/centralnye-ustanovki/freonovye-ohladiteli/ [R=301,L,NE]
RewriteRule ^catalog/filtr_f[123](?:/[0-9]+)?/?$ /product/centralnye-ustanovki/sekcii-filtracii/ [R=301,L,NE]
RewriteRule ^catalog/vodyanye_vozdukhonagrevateli_hx/[0-9]+/?$ /product/centralnye-ustanovki/vodyanye-nagrevateli/ [R=301,L,NE]
RewriteRule ^catalog/sektsii_ventilyatorov_/[0-9]+/?$ /product/centralnye-ustanovki/ventilyatornye-sekcii/ [R=301,L,NE]
RewriteRule ^catalog/sektsii_smesheniya_vozdukha_r_pu_pd_pl_pr_i_promezhutochnye_sektsii_u_/[0-9]+/?$ /product/centralnye-ustanovki/sekcii-smesheniya/ [R=301,L,NE]
RewriteRule ^catalog/sektsii_vodyanogo_vozdukhookhladitelya_wxx/[0-9]+/?$ /product/centralnye-ustanovki/vodyanye-ohladiteli/ [R=301,L,NE]
RewriteRule ^catalog/sektsii_shumoglusheniya_y1_y2_y3/[0-9]+/?$ /product/centralnye-ustanovki/shumoglushiteli/ [R=301,L,NE]
RewriteRule ^catalog/sektsii_sotovogo_uvlazhnitelya_/[0-9]+/?$ /product/centralnye-ustanovki/sotovye-uvlazhniteli/ [R=301,L,NE]
RewriteRule ^catalog/sektsii_rotornykh_regeneratorov_rr/[0-9]+/?$ /product/centralnye-ustanovki/rotornye-regeneratory/ [R=301,L,NE]
RewriteRule ^catalog/rezervnaya_sistema_ventilyatsii/[0-9]+/?$ /product/centralnye-ustanovki/ventilyatornye-s-rezervom/ [R=301,L,NE]
RewriteRule ^catalog/ventilyatory_kryshnye_obshchepromyshlennye_krv_v/[0-9]+/?$ /product/ventilyatory-kryshnye-krv-v/ [R=301,L,NE]
RewriteRule ^catalog/kryshnye_ventilyatory_krv/[0-9]+/?$ /product/ventilyatory-kryshnye-krv/ [R=301,L,NE]
RewriteRule ^catalog/ventilyatory_radialnye_obshchepromyshlennye_rr/[0-9]+/?$ /product/ventilyatory-radialnye-rr/ [R=301,L,NE]
RewriteRule ^catalog/shumoglushiteli_kruglye/[0-9]+/?$ /product/shumoglushitel-rq-kruglyj/ [R=301,L,NE]
RewriteRule ^catalog/klapana_germeticheskie_ventilyatsionnye/[0-9]+/?$ /product/germeticheskie-klapany/ [R=301,L,NE]
RewriteRule ^catalog/klapan_izbytochnogo_davleniya_kid/[0-9]+/?$ /product/klapany-izbytochnogo-davleniya-kid/ [R=301,L,NE]
RewriteRule ^catalog/filtry_vozdushnye_kassetnye_(?:/[0-9]+)?/?$ /product/filtry-vozdushnye-kassetnye-rf/ [R=301,L,NE]
RewriteRule ^catalog/elektricheskie_vozdukhonagrevateli_/[0-9]+/?$ /product/elektricheskie-vozduhonagrevateli-re-kruglye/ [R=301,L,NE]
RewriteRule ^catalog/zaslonki_kruglye/?$ /product/kanalnoe-krugloe/ [R=301,L,NE]
RewriteRule ^catalog/vodyanye_vozdukhonagrevateli_/?$ /product/vodyanye-vozduhonagrevateli-rw-kruglye/ [R=301,L,NE]
RewriteRule ^catalog/obratnye_klapany_ro/?$ /product/klapan-obratnyj-ro-kruglyj/ [R=301,L,NE]
RewriteRule ^catalog/fankoyly(?:/.*)?/?$ /products/ [R=301,L,NE]
RewriteRule ^catalog(?:/.*)?/?$ /products/ [R=301,L,NE]
RewriteRule ^upload/medialibrary/.*\.pdf$ /tehlisty/ [R=301,L,NE]
RewriteRule ^company/blog(?:/.*)?/?$ /news/ [R=301,L,NE]
RewriteRule ^company(?:/.*)?/?$ /about/ [R=301,L,NE]
RewriteRule ^dostavka-oplata-garantii(?:/.*)?/?$ /contacts/ [R=301,L,NE]
RewriteRule ^sale(?:/.*)?/?$ /news/ [R=301,L,NE]
RewriteRule ^help(?:/.*)?/?$ /contacts/ [R=301,L,NE]

# Exported routes are directories; redirect directly to their final HTTPS URL.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^ https://rik-vent.ru%{REQUEST_URI}/ [R=301,L,NE]

# Keep one canonical host to avoid duplicate pages in search indexes.
RewriteCond %{HTTP_HOST} ^www\.rik-vent\.ru$ [NC]
RewriteRule ^ https://rik-vent.ru%{REQUEST_URI} [R=301,L,NE]

# The API is implemented by PHP on Timeweb shared Hosting.
RewriteRule ^api/index\.php$ - [L]
RewriteRule ^api(?:/(.*))?$ api/index.php?route=$1 [QSA,L]

# Keep real static files and directories handled directly by the web server.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Unknown URLs must stay real 404 responses instead of becoming soft 404s.

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  <FilesMatch "\.(?:css|js|mjs|woff2?|ttf|eot|webp|png|jpe?g|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:html|xml|txt|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType video/mp4 .mp4
  AddType font/woff2 .woff2
</IfModule>

Options -Indexes
