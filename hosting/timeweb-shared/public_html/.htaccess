DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On

# Preserve search equity from the pre-2026 Bitrix URL structure.
# Directory rules accept both the historical trailing-slash URL and its
# no-slash variant, but always land on the current canonical URL.
RewriteRule ^catalog/tsentralnye_karkasnye_konditsionery_rik_m_i_rik_s/?$ https://rik-vent.ru/product/centralnye-ustanovki/ [R=301,L,NE]
RewriteRule ^catalog/klapana_protivopozharnye_kanalnye_/?$ https://rik-vent.ru/product/protivopozharnye-klapany/ [R=301,L,NE]
RewriteRule ^catalog/sektsii_plastinchatykh_rekuperatorov_rp/?$ https://rik-vent.ru/product/centralnye-ustanovki/plastinchatye-rekuperatory/ [R=301,L,NE]
RewriteRule ^catalog/kanalnoe_oborudovanie/?$ https://rik-vent.ru/product/kanalnoe-oborudovanie/ [R=301,L,NE]
RewriteRule ^company/blog/printsip_raboty_tsentralnykh_karkasno_panelnykh_konditsionerov/?$ https://rik-vent.ru/product/centralnye-ustanovki/ [R=301,L,NE]
RewriteRule ^catalog/klapana/?$ https://rik-vent.ru/product/specialnye-klapany/ [R=301,L,NE]
RewriteRule ^upload/medialibrary/0bd/ayn0ko0zc8e8gc38960kbcyhwb816coe\.pdf$ https://rik-vent.ru/product/centralnye-ustanovki/ [R=301,L,NE]
RewriteRule ^catalog/ventilyatory_kanalnye_wr_i_wrn/?$ https://rik-vent.ru/product/ventilyator-wr/ [R=301,L,NE]
RewriteRule ^catalog/zatvory/?$ https://rik-vent.ru/product/ventilyatsionnye-zatvory/ [R=301,L,NE]
RewriteRule ^catalog/kanalnoe_krugloe_oborudovanie/?$ https://rik-vent.ru/product/kanalnoe-krugloe/ [R=301,L,NE]
RewriteRule ^catalog/plastinchatye_rekuperatory_rec/?$ https://rik-vent.ru/product/plastinchatyj-rekuperator-rec/ [R=301,L,NE]
RewriteRule ^catalog/reguliruyushchie_zaslonki_s/?$ https://rik-vent.ru/product/zaslonka-reguliruyushchaya-rkz/ [R=301,L,NE]
RewriteRule ^catalog/elektricheskie_vozdukhonagrevateli_euuu/?$ https://rik-vent.ru/product/elektricheskie-vozduhonagrevateli-re/ [R=301,L,NE]
RewriteRule ^catalog/nerzhaveyushchaya_stal_ot_0_5_do_1_0/?$ https://rik-vent.ru/product/vozduhovody-i-fasonnye-izdeliya/ [R=301,L,NE]
RewriteRule ^catalog/ventilyatory_kanalnye_/?$ https://rik-vent.ru/product/kanalnoe-oborudovanie/ [R=301,L,NE]
RewriteRule ^catalog/zonty_kryshnyy/?$ https://rik-vent.ru/product/vozduhovody-i-fasonnye-izdeliya/ [R=301,L,NE]
RewriteRule ^company/blog/printsip_raboty_vozdushnykh_zaslonok_ruchnye_mekhanicheskie_i_avtomaticheskie/?$ https://rik-vent.ru/product/specialnye-klapany/ [R=301,L,NE]
RewriteRule ^upload/medialibrary/3eb/5tftc56ji3vyx6gj8q51x7ckr0lv6224\.pdf$ https://rik-vent.ru/product/protivopozharnye-klapany/ [R=301,L,NE]
RewriteRule ^catalog/?$ https://rik-vent.ru/products/ [R=301,L,NE]
RewriteRule ^catalog/kanalnoe_pryamougolnoe_oborudovanie/?$ https://rik-vent.ru/product/kanalnoe-pryamougolnoe/ [R=301,L,NE]
RewriteRule ^company/?$ https://rik-vent.ru/about/ [R=301,L,NE]
RewriteRule ^company/articles/?$ https://rik-vent.ru/projects/ [R=301,L,NE]
RewriteRule ^company/rekvizity/?$ https://rik-vent.ru/requisites/ [R=301,L,NE]
RewriteRule ^company/jobs/?$ https://rik-vent.ru/careers/ [R=301,L,NE]
RewriteRule ^dostavka-oplata-garantii/?$ https://rik-vent.ru/about/ [R=301,L,NE]
RewriteRule ^dostavka-oplata-garantii/dostavka/?$ https://rik-vent.ru/contacts/ [R=301,L,NE]
RewriteRule ^dostavka-oplata-garantii/garantii/?$ https://rik-vent.ru/about/ [R=301,L,NE]
RewriteRule ^dostavka-oplata-garantii/oplata/?$ https://rik-vent.ru/contacts/ [R=301,L,NE]
RewriteRule ^izgotovlenie-na-zakaz/?$ https://rik-vent.ru/production/ [R=301,L,NE]
RewriteRule ^sale/sad/?$ https://rik-vent.ru/news/ [R=301,L,NE]
RewriteRule ^help/delivery/?$ https://rik-vent.ru/contacts/ [R=301,L,NE]
RewriteRule ^kak-oformit-zakaz/?$ https://rik-vent.ru/request/ [R=301,L,NE]
RewriteRule ^legacy-cookies-agreement\.php$ https://rik-vent.ru/privacy/ [R=301,L,NE]

# Indexed legacy model cards keep the closest current product/category intent.
# Final namespace fallbacks prevent any remaining Bitrix result from landing on 404.
RewriteRule ^catalog/sektsii_plastinchatykh_rekuperatorov_rp/[0-9]+/?$ https://rik-vent.ru/product/centralnye-ustanovki/plastinchatye-rekuperatory/ [R=301,L,NE]
RewriteRule ^catalog/elektricheskie_vozdukhonagrevateli_euuu/[0-9]+/?$ https://rik-vent.ru/product/centralnye-ustanovki/elektricheskie-nagrevateli/ [R=301,L,NE]
RewriteRule ^catalog/sektsiya_isparitelya_freonovogo_cxy/[0-9]+/?$ https://rik-vent.ru/product/centralnye-ustanovki/freonovye-ohladiteli/ [R=301,L,NE]
RewriteRule ^catalog/filtr_f[123](?:/[0-9]+)?/?$ https://rik-vent.ru/product/centralnye-ustanovki/sekcii-filtracii/ [R=301,L,NE]
RewriteRule ^catalog/vodyanye_vozdukhonagrevateli_hx/[0-9]+/?$ https://rik-vent.ru/product/centralnye-ustanovki/vodyanye-nagrevateli/ [R=301,L,NE]
RewriteRule ^catalog/sektsii_ventilyatorov_/[0-9]+/?$ https://rik-vent.ru/product/centralnye-ustanovki/ventilyatornye-sekcii/ [R=301,L,NE]
RewriteRule ^catalog/sektsii_smesheniya_vozdukha_r_pu_pd_pl_pr_i_promezhutochnye_sektsii_u_/[0-9]+/?$ https://rik-vent.ru/product/centralnye-ustanovki/sekcii-smesheniya/ [R=301,L,NE]
RewriteRule ^catalog/sektsii_vodyanogo_vozdukhookhladitelya_wxx/[0-9]+/?$ https://rik-vent.ru/product/centralnye-ustanovki/vodyanye-ohladiteli/ [R=301,L,NE]
RewriteRule ^catalog/sektsii_shumoglusheniya_y1_y2_y3/[0-9]+/?$ https://rik-vent.ru/product/centralnye-ustanovki/shumoglushiteli/ [R=301,L,NE]
RewriteRule ^catalog/sektsii_sotovogo_uvlazhnitelya_/[0-9]+/?$ https://rik-vent.ru/product/centralnye-ustanovki/sotovye-uvlazhniteli/ [R=301,L,NE]
RewriteRule ^catalog/sektsii_rotornykh_regeneratorov_rr/[0-9]+/?$ https://rik-vent.ru/product/centralnye-ustanovki/rotornye-regeneratory/ [R=301,L,NE]
RewriteRule ^catalog/rezervnaya_sistema_ventilyatsii/[0-9]+/?$ https://rik-vent.ru/product/centralnye-ustanovki/ventilyatornye-s-rezervom/ [R=301,L,NE]
RewriteRule ^catalog/ventilyatory_kryshnye_obshchepromyshlennye_krv_v/[0-9]+/?$ https://rik-vent.ru/product/ventilyatory-kryshnye-krv-v/ [R=301,L,NE]
RewriteRule ^catalog/kryshnye_ventilyatory_krv/[0-9]+/?$ https://rik-vent.ru/product/ventilyatory-kryshnye-krv/ [R=301,L,NE]
RewriteRule ^catalog/ventilyatory_radialnye_obshchepromyshlennye_rr/[0-9]+/?$ https://rik-vent.ru/product/ventilyatory-radialnye-rr/ [R=301,L,NE]
RewriteRule ^catalog/shumoglushiteli_kruglye/[0-9]+/?$ https://rik-vent.ru/product/shumoglushitel-rq-kruglyj/ [R=301,L,NE]
RewriteRule ^catalog/klapana_germeticheskie_ventilyatsionnye/[0-9]+/?$ https://rik-vent.ru/product/germeticheskie-klapany/ [R=301,L,NE]
RewriteRule ^catalog/klapan_izbytochnogo_davleniya_kid/[0-9]+/?$ https://rik-vent.ru/product/klapany-izbytochnogo-davleniya-kid/ [R=301,L,NE]
RewriteRule ^catalog/filtry_vozdushnye_kassetnye_(?:/[0-9]+)?/?$ https://rik-vent.ru/product/filtry-vozdushnye-kassetnye-rf/ [R=301,L,NE]
RewriteRule ^catalog/elektricheskie_vozdukhonagrevateli_/[0-9]+/?$ https://rik-vent.ru/product/elektricheskie-vozduhonagrevateli-re-kruglye/ [R=301,L,NE]
RewriteRule ^catalog/zaslonki_kruglye/?$ https://rik-vent.ru/product/kanalnoe-krugloe/ [R=301,L,NE]
RewriteRule ^catalog/vodyanye_vozdukhonagrevateli_/?$ https://rik-vent.ru/product/vodyanye-vozduhonagrevateli-rw-kruglye/ [R=301,L,NE]
RewriteRule ^catalog/obratnye_klapany_ro/?$ https://rik-vent.ru/product/klapan-obratnyj-ro-kruglyj/ [R=301,L,NE]
RewriteRule ^catalog/fankoyly(?:/.*)?/?$ https://rik-vent.ru/products/ [R=301,L,NE]
RewriteRule ^catalog(?:/.*)?/?$ https://rik-vent.ru/products/ [R=301,L,NE]
RewriteRule ^upload/medialibrary/.*\.pdf$ https://rik-vent.ru/tehlisty/ [R=301,L,NE]
RewriteRule ^company/blog(?:/.*)?/?$ https://rik-vent.ru/news/ [R=301,L,NE]
RewriteRule ^company(?:/.*)?/?$ https://rik-vent.ru/about/ [R=301,L,NE]
RewriteRule ^dostavka-oplata-garantii(?:/.*)?/?$ https://rik-vent.ru/contacts/ [R=301,L,NE]
RewriteRule ^sale(?:/.*)?/?$ https://rik-vent.ru/news/ [R=301,L,NE]
RewriteRule ^help(?:/.*)?/?$ https://rik-vent.ru/contacts/ [R=301,L,NE]

# Exported routes are directories; redirect directly to their final HTTPS URL.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^ https://rik-vent.ru%{REQUEST_URI}/ [R=301,L,NE]

# Keep one canonical host to avoid duplicate pages in search indexes.
RewriteCond %{HTTP_HOST} ^www\.rik-vent\.ru$ [NC]
RewriteRule ^ https://rik-vent.ru%{REQUEST_URI} [R=301,L,NE]

# The API is implemented by PHP on Timeweb shared Hosting.
RewriteRule ^api/index\.php$ - [L]
RewriteRule ^api(?:/(.*))?$ api/index.php?route=$1 [QSA,L]

# Keep real static files and directories handled directly by the web server.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Unknown URLs must stay real 404 responses instead of becoming soft 404s.

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  <FilesMatch "\.(?:css|js|mjs|woff2?|ttf|eot|webp|png|jpe?g|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:html|xml|txt|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType video/mp4 .mp4
  AddType font/woff2 .woff2
</IfModule>

Options -Indexes
