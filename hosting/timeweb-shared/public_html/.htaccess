DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On

# Exported routes are directories; redirect directly to their final HTTPS URL.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^ https://rik-vent.ru%{REQUEST_URI}/ [R=301,L,NE]

# Keep one canonical host to avoid duplicate pages in search indexes.
RewriteCond %{HTTP_HOST} ^www\.rik-vent\.ru$ [NC]
RewriteRule ^ https://rik-vent.ru%{REQUEST_URI} [R=301,L,NE]

# The API is implemented by PHP on Timeweb shared Hosting.
RewriteRule ^api/index\.php$ - [L]
RewriteRule ^api(?:/(.*))?$ api/index.php?route=$1 [QSA,L]

# Keep real static files and directories handled directly by the web server.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Unknown URLs must stay real 404 responses instead of becoming soft 404s.

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  <FilesMatch "\.(?:css|js|mjs|woff2?|ttf|eot|webp|png|jpe?g|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:html|xml|txt|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType video/mp4 .mp4
  AddType font/woff2 .woff2
</IfModule>

Options -Indexes
