# Supabase RAG memory
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Retrieval settings
RAG_TOP_K=8
RAG_SIMILARITY_THRESHOLD=0.25
RAG_MAX_CONTEXT_CHARS=12000
RAG_CHUNK_MAX_CHARS=1200
RAG_CHUNK_OVERLAP_CHARS=180
RAG_NAMESPACE=site

# Embeddings
# Use OpenRouter if possible, because the chatbot already uses OpenRouter for chat.
RAG_EMBEDDING_PROVIDER=openrouter
RAG_EMBEDDING_MODEL=openai/text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=1536

# Chat model fallback chain remains separate from embeddings.
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_MODELS=poolside/laguna-m.1:free,tencent/hy3:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free


