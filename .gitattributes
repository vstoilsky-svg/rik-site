* text=auto

# Source and deployment files must remain LF inside Git and Linux containers.
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
Dockerfile text eol=lf

# Native Windows helper scripts.
*.ps1 text eol=crlf

# Binary assets.
*.avif binary
*.doc binary
*.docx binary
*.gif binary
*.ico binary
*.jpeg binary
*.jpg binary
*.pdf binary
*.png binary
*.ppt binary
*.pptx binary
*.rfa binary
*.tar binary
*.webp binary
*.woff binary
*.woff2 binary
*.xls binary
*.xlsx binary
*.zip binary
